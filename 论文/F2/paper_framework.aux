\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Small-scale results: the two exact methods, with $K=2$ and processing times from $[1,10]$. ``proved'' counts the instances whose optimality the MILP model established within the time limit. The MILP model is the baseline at this scale and so reads zero by construction; the DP gap is its mean gap \eqref  {eq:gap} against that baseline, a negative entry marking instances on which it returned a better schedule than the model. The two methods necessarily agree wherever the model proved optimality.}}{32}{table.4}\protected@file@percent }
\newlabel{tab:results-small}{{4}{32}{Small-scale results: the two exact methods, with $K=2$ and processing times from $[1,10]$. ``proved'' counts the instances whose optimality the MILP model established within the time limit. The MILP model is the baseline at this scale and so reads zero by construction; the DP gap is its mean gap \eqref {eq:gap} against that baseline, a negative entry marking instances on which it returned a better schedule than the model. The two methods necessarily agree wherever the model proved optimality}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Medium-scale results under the wide weight regime (all weights distinct): mean relative gap \eqref  {eq:gap} in percent, with respect to the 2-approximation, which is the baseline at this scale and therefore reads zero by construction. A negative entry marks a method that improved on the baseline. ``indep.'' and ``corr.'' denote weights independent of, and positively correlated with, the processing times.}}{32}{table.5}\protected@file@percent }
\newlabel{tab:results-medium}{{5}{32}{Medium-scale results under the wide weight regime (all weights distinct): mean relative gap \eqref {eq:gap} in percent, with respect to the 2-approximation, which is the baseline at this scale and therefore reads zero by construction. A negative entry marks a method that improved on the baseline. ``indep.'' and ``corr.'' denote weights independent of, and positively correlated with, the processing times}{table.5}{}}
\@writefile{toc}{\contentsline {paragraph}{Medium scale: ranking of the heuristics.}{32}{section*.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Large-scale results under the wide weight regime (all weights distinct): mean relative gap \eqref  {eq:gap} in percent, with respect to the 2-approximation, which is the baseline at this scale and therefore reads zero by construction. A negative entry marks a method that improved on the baseline. The exact methods are out of reach at this scale.}}{33}{table.6}\protected@file@percent }
\newlabel{tab:results-large}{{6}{33}{Large-scale results under the wide weight regime (all weights distinct): mean relative gap \eqref {eq:gap} in percent, with respect to the 2-approximation, which is the baseline at this scale and therefore reads zero by construction. A negative entry marks a method that improved on the baseline. The exact methods are out of reach at this scale}{table.6}{}}
